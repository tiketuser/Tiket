{
  "hosting": [
    {
      "target": "staging",
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "tiket-app-staging",
            "region": "me-west1"
          }
        }
      ]
    },
    {
      "target": "production",
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "tiket-app",
            "region": "me-west1"
          }
        }
      ]
    }
  ],
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
